# Environment template for Cream. Copy to `.env` and fill in.
#
# Development (see README "First-time setup"): set the POSTGRES_* vars
# for your local database and DEBUG=1; the rest can be left out.
#
# Production (specs/014): this file lives next to docker-compose.yml on
# the server, is never committed, and is excluded from deploy rsyncs.

# --- Required everywhere ---
POSTGRES_DB=cream
POSTGRES_USER=cream
POSTGRES_PASSWORD=change-me
# In production these are overridden by docker-compose.yml (the db
# service); for local dev use your local Postgres, e.g. localhost:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Development only ---
# Enables Django debug mode. Leave unset in production.
#DEBUG=1

# --- Production only ---
# Host port the app is published on (localhost only); nginx proxies to
# this. Read by docker compose, not Django. Defaults to 8000.
#PORT=8000
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
#SECRET_KEY=
# Comma-separated hostnames / origins for the deployed site.
#ALLOWED_HOSTS=cream.example.com
#CSRF_TRUSTED_ORIGINS=https://cream.example.com

# --- Optional Aient telemetry (serving workers only) ---
# Copy the publishable ingest key from Aient; never commit a live key.
# Empty/unset disables capture. OTEL_SDK_DISABLED=true also disables it.
AIENT_PUBLISHABLE_KEY=
OTEL_SERVICE_NAME=cream
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.aient.ai
AIENT_ENV=prod
# Full 40-character SHA of the deployed source; required for production compose.
# Set these per deploy from the source checkout, before rsync excludes .git.
#COMMIT_SHA=
#COMMIT_REF=main
