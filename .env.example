# Environment template for Cream. Copy to `.env` and fill in.
#
# Development (see README "First-time setup"): set the POSTGRES_* vars
# for your local database and DEBUG=1; the rest can be left out.
#
# Production (specs/014): this file lives next to docker-compose.yml on
# the server, is never committed, and is excluded from deploy rsyncs.

# --- Required everywhere ---
POSTGRES_DB=cream
POSTGRES_USER=cream
POSTGRES_PASSWORD=change-me
# In production these are overridden by docker-compose.yml (the db
# service); for local dev use your local Postgres, e.g. localhost:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Development only ---
# Enables Django debug mode. Leave unset in production.
#DEBUG=1

# --- Production only ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
#SECRET_KEY=
# Comma-separated hostnames / origins for the deployed site.
#ALLOWED_HOSTS=cream.example.com
#CSRF_TRUSTED_ORIGINS=https://cream.example.com
